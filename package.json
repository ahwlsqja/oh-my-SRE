{
  "name": "oh-my-sre",
  "version": "0.1.0",
  "private": true,
  "description": "등록 런북과 근거 검증을 연결하는 범용 SRE 에이전트의 첫 로컬 실행 slice",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src core providers storage runbooks tests scripts server vite.config.ts playwright.config.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "pnpm tokens:check && pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "licenses:generate": "node scripts/generate-notices.mjs",
    "tokens:generate": "node scripts/generate-sds.mjs",
    "tokens:check": "node scripts/generate-sds.mjs --check",
    "test:sds": "node --test scripts/sds-contract.test.mjs",
    "test:uptime": "node --experimental-strip-types --test scripts/uptime-contract.test.mjs",
    "test:receipt": "node --experimental-strip-types --test scripts/receipt-contract.test.mjs",
    "test:core": "node --experimental-strip-types --test scripts/core-*.test.mjs runbooks/*/tests/*.test.mjs",
    "engine:demo": "node --experimental-strip-types scripts/engine-demo.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.33.0"
}
